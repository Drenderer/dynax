# %% Define the function
from jax import numpy as jnp
from jax.scipy.optimize import minimize


def normalize_std(std, std_t, std_tt):
    std_sq = std**2
    std_t_sq = std_t**2
    std_tt_sq = std_tt**2

    def numerator(tau):
        return std + std_t * tau + std_tt * tau**2

    def denominator(tau):
        return std_sq + std_t_sq * tau**2 + std_tt_sq * tau**4

    def fun(tau: float):
        return -(numerator(tau) ** 2) / denominator(tau)

    _temp = std_t / std
    tau_init = jnp.sum(_temp) / jnp.sum(_temp**2)

    tau = minimize(
        fun, tau_init, method="BFGS", tol=1e-6, options=dict(maxiter=10)
    )

    alpha = numerator(tau) / denominator(tau)

    return alpha, tau


